# carSelection 前端服务（systemd，非容器部署选项；由 nginx 反代 3000）
# 安装：cp deploy/systemd/carsel-web.service /etc/systemd/system/
#       systemctl daemon-reload && systemctl enable --now carsel-web
[Unit]
Description=carSelection Next.js frontend
After=network-online.target carsel-api.service
Wants=network-online.target

[Service]
Type=simple
User=carsel
Group=carsel
WorkingDirectory=/srv/carsel/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=BACKEND_URL=http://127.0.0.1:8000
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=5
MemoryMax=1G
CPUQuota=150%

[Install]
WantedBy=multi-user.target
