# 复制为 .env 使用；所有值均为占位符。
# 真实密钥只放本机 .env（已被 .gitignore 忽略，文件权限 600），禁止提交。
# 字段状态注释：[已支持]=代码已读取；[接入时生效]=该能力尚未接线，填好后由开发侧接入。

# ── 数据库（云 RDS PostgreSQL）───────────────────────────────────────────────
# [已支持] 本地开发默认 SQLite；生产切换为：
# DATABASE_URL=postgresql://carapp:你的密码@rm-xxx.pg.rds.aliyuncs.com:5432/carapp
DATABASE_URL=sqlite:///./dev.db
AUTO_CREATE_TABLES=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── 大模型（DeepSeek API）────────────────────────────────────────────────────
# [已支持] 留空时 Agent 以确定性模式运行（不调用模型）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── Redis（云 Redis：会话/限流/验证码，生产替换进程内存储）──────────────────
# [已支持] 配置后自动切换 Redis 存储（连接失败回退进程内，原则 7）
REDIS_URL=redis://:你的密码@r-xxx.redis.rds.aliyuncs.com:6379/0

# ── Milvus 向量库（Zilliz Cloud REST，免 pymilvus）──────────────────────────
# [已支持] RETRIEVAL_BACKEND / MILVUS_URI / MILVUS_TOKEN / COLLECTION / DIM 已读取
RETRIEVAL_BACKEND=inmemory
MILVUS_URI=
MILVUS_COLLECTION=car_docs
MILVUS_DIM=1024
MILVUS_TOKEN=
# embedding 方案（三选一）：zilliz_builtin | siliconflow | openai_compatible
# 实测结论（2026-08）：Zilliz 内置 embedding 域名 api.zillizcloud.com 委托在 AWS，
# 大陆 DNS 返回 NODATA 基本不可达；且阿里杭州 serverless 集群不支持服务端
# TEXTEMBEDDING Function（返回 Unsupported function type）。
# → 大陆部署请用国内供应商；本项目默认采用【阿里云百炼（DashScope）】：
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# text-embedding-v3 支持 1024/768/512；必须与 MILVUS_DIM 一致
EMBEDDING_DIMENSIONS=1024
# embedding 向量本地缓存（稠密重建断点续跑：配额/网络中断后重跑只补未完成批次；留空关闭）
RETRIEVAL_EMBED_CACHE=
# 替代方案：硅基流动（BAAI/bge-m3，1024 维）
#   EMBEDDING_BASE_URL=https://api.siliconflow.cn  EMBEDDING_MODEL=BAAI/bge-m3

# ── RAG 检索流水线（召回为「稀疏 ∥ 稠密」双路 + 加权 RRF 融合）────────────────
# [已支持] 读取处见 backend/app/retrieval/config.py；下方为默认值占位
# 双路架构：sparse = 进程内 BM25（中英分词，车型名/参数键值的精确匹配主力，
#           零外部依赖、始终可用——本地无云也能跑全部功能，原则 7）；
#           dense = Zilliz 向量（语义改写匹配，RETRIEVAL_BACKEND=milvus 时启用）。
#           查询经 analyze 意图分流：参数/对比类查询只走稀疏快路，语义类两路并行。
# 实测依据（RAG.md §4.2）：稀疏单路 Hit@5 0.7778 > 稠密单路 0.6889——
# 本项目查询以「实体+参数」为主，BM25 是精度主力，稠密负责语义兜底。
# 切分：递归切分 + 相邻切片重叠（字符），防止句界证据被割裂（来源文档正文用；
#       款型参数切片按款型级合并装填，同样以 CHUNK_SIZE 为单片预算）
RETRIEVAL_CHUNK_SIZE=500
RETRIEVAL_CHUNK_OVERLAP=64
# 稀疏分词器：bigram（默认，A/B 实测本语料最优）| jieba（整词）| hybrid（整词+二元组）
RETRIEVAL_TOKENIZER=bigram
# 召回与融合：每路召回条数 = top_k × RECALL_MULTIPLIER；RRF 融合常数与路权重
# （统一 0.6/0.4——120 题五配置消融实测最优：等权 0.6948 / 纯稀疏 0.6898 /
#   稠密偏重 0.4/0.6 有害；0.6~0.8 稀疏权重为 MRR 平台期。0<w<=1）
RETRIEVAL_RECALL_MULTIPLIER=6
RETRIEVAL_RRF_K=60
RETRIEVAL_RRF_WEIGHT_SPARSE=0.6
RETRIEVAL_RRF_WEIGHT_DENSE=0.4
# 相关性阈值（重排器输出的绝对相关分，低于该值的证据被过滤；0 = 不过滤）
RETRIEVAL_RELEVANCE_THRESHOLD=0.0
# HyDE：语义类查询由 LLM 生成假设性证据文本再做稠密召回（+1 次 LLM 调用，默认关）
RETRIEVAL_HYDE=
# 索引规模护栏：切片总量上限 / 每款型事实条数上限
RETRIEVAL_MAX_CHUNKS=60000
RETRIEVAL_FACTS_PER_VARIANT=30
# 重排器：RERANK_PROVIDER = ""（默认，不重排、保持融合序——520 题 A/B 实测最优）
#        | lexical（词元重排）| api（Cross-Encoder，语义查询占比高的部署可开启并用评测复验）
RERANK_PROVIDER=
# RERANK_PROVIDER=api 时填写。阿里百炼示例（端点路径自动适配 /reranks 与原生 text-rerank）：
#   RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
#   RERANK_MODEL=qwen3.7-text-rerank
# 硅基流动示例：https://api.siliconflow.cn/v1 + BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=
RERANK_MODEL=
# 留空时自动回退 EMBEDDING_API_KEY（同账号场景免重复配置）
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=10.0
# 显式指定重排 API 路径（默认空 = 按 base_url 自动探测）
RERANK_API_PATH=
# 词元重排的加权/封顶幅度（仅 lexical 生效）
RETRIEVAL_LEXICAL_BOOST=0.05
RETRIEVAL_LEXICAL_CAP=0.25
# RAG 运行日志环形缓冲长度（管理后台运维页读取）
RAG_RUN_LOG_SIZE=50

# ── 对象存储（OSS：网页快照/PDF/图片）───────────────────────────────────────
# [已支持] 配置后抓取快照自动上传（失败仅本地存档，原则 7）
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ── 验证码邮件（SMTP，生产投递通道）─────────────────────────────────────────
# [已支持] 配置后验证码走邮件；未配置时开发模式日志输出
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com

# ── 开发/运维开关 ─────────────────────────────────────────────────────────────
# 开发便利：注册/登录响应回显验证码（生产必须为 false）
DEV_ECHO_CODES=false
# 管理后台独立凭据（生产由 KMS 注入；留空则管理接口禁用）
ADMIN_API_TOKEN=
